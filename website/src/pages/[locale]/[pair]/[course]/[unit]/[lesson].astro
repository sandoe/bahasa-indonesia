---
import BaseLayout from "@layouts/BaseLayout.astro";
import ModeSplit from "@components/ModeSplit.astro";
import { getCourses, getLessons, getStaticRouteMatrix } from "@lib/content";
import { getDirectionLabel, t } from "@lib/i18n";
import { pairMeta, uiCopy, type LearningPair, type LocalizedText, type UiLocale } from "@data/site";

export async function getStaticPaths() {
  const [lessons, matrix] = await Promise.all([getLessons(), Promise.resolve(getStaticRouteMatrix())]);
  return matrix.flatMap(({ locale, pair }) =>
    lessons
      .filter((lesson) => lesson.data.pair === pair)
      .map((lesson) => ({
        params: {
          locale,
          pair,
          course: lesson.data.courseSlug,
          unit: lesson.data.unit.slug,
          lesson: lesson.data.slug
        }
      }))
  );
}

const locale = Astro.params.locale as UiLocale;
const pair = Astro.params.pair as LearningPair;
const course = Astro.params.course ?? "";
const unit = Astro.params.unit ?? "";
const lessonSlug = Astro.params.lesson ?? "";

const [lessons, courses] = await Promise.all([getLessons(), getCourses()]);

const lesson = lessons.find(
  (entry) =>
    entry.data.pair === pair &&
    entry.data.courseSlug === course &&
    entry.data.unit.slug === unit &&
    entry.data.slug === lessonSlug
);

if (!lesson) {
  throw new Error(`Unknown lesson route: ${course}/${unit}/${lessonSlug}`);
}

const courseData = courses.find((c) => c.data.slug === course);

const pairCourseLessons = lessons
  .filter((l) => l.data.pair === pair && l.data.courseSlug === course)
  .sort((a, b) => {
    if (a.data.unit.order !== b.data.unit.order) return a.data.unit.order - b.data.unit.order;
    return a.data.order - b.data.order;
  });

const currentIdx = pairCourseLessons.findIndex(
  (l) => l.data.slug === lessonSlug && l.data.unit.slug === unit
);
const prevLesson = currentIdx > 0 ? pairCourseLessons[currentIdx - 1] : null;
const nextLesson = currentIdx < pairCourseLessons.length - 1 ? pairCourseLessons[currentIdx + 1] : null;
const uiText = {
  minutes: { da: "minutter", en: "minutes", id: "menit" },
  interaction: { da: "Interaktion", en: "Interaction", id: "Interaksi" },
  learningModules: { da: "Læringsmoduler", en: "Learning Modules", id: "Modul belajar" },
  skills: { da: "Færdigheder", en: "Skills", id: "Keterampilan" },
  thisTrains: { da: "Det her træner du", en: "What you train here", id: "Yang Anda latih di sini" },
  skillIntro: {
    da: "Hver lektion skal gerne mærkes som rigtig sprogbrug, ikke bare som opslag. Derfor viser vi tydeligt hvilke færdigheder der er i spil her.",
    en: "Each lesson should feel like real language use, not just reference material. That is why we show clearly which skills are involved here.",
    id: "Setiap pelajaran sebaiknya terasa seperti penggunaan bahasa yang nyata, bukan sekadar materi acuan. Karena itu kami menunjukkan dengan jelas keterampilan apa saja yang dilatih di sini."
  },
  activeHere: { da: "Trænes her", en: "Trained here", id: "Dilatih di sini" },
  supporting: { da: "Støttes indirekte", en: "Supported indirectly", id: "Didukung secara tidak langsung" },
  context: { da: "Kontekst", en: "Context", id: "Konteks" },
  modelDialogue: { da: "Modeldialog", en: "Model Dialogue", id: "Dialog model" },
  lexicon: { da: "Leksikon", en: "Lexicon", id: "Leksikon" },
  wordBank: { da: "Ordbank", en: "Word Bank", id: "Bank kata" },
  structure: { da: "Struktur", en: "Structure", id: "Struktur" },
  grammar: { da: "Grammatik", en: "Grammar", id: "Tata bahasa" },
  practice: { da: "Træning", en: "Practice", id: "Latihan" },
  exercises: { da: "Øvelser", en: "Exercises", id: "Latihan" },
  previousLesson: { da: "Forrige lektion", en: "Previous lesson", id: "Pelajaran sebelumnya" },
  backTo: { da: "Tilbage til", en: "Back to", id: "Kembali ke" },
  courseOverview: { da: "Kursoversigt", en: "Course overview", id: "Ringkasan kursus" },
  nextLesson: { da: "Næste lektion", en: "Next lesson", id: "Pelajaran berikutnya" }
} as const;

const skillSignals = {
  speak:
    lesson.data.activities.some((activity) => activity.kind === "speak") ||
    lesson.data.dialogue.length > 0,
  listen:
    lesson.data.activities.some((activity) => activity.kind === "listen") ||
    lesson.data.dialogue.length > 0 ||
    lesson.data.media.some((item) => item.type === "audio" || item.type === "video"),
  read:
    lesson.data.dialogue.length > 0 ||
    lesson.data.vocabulary.length > 0 ||
    lesson.data.grammar.length > 0 ||
    lesson.data.activities.some((activity) => activity.kind === "build"),
  write:
    lesson.data.activities.some((activity) => activity.kind === "build" || activity.kind === "reflect") ||
    lesson.data.modes.selfStudy.path.some((step) => /skriv|write|tulis/i.test(`${step.da} ${step.en} ${step.id}`))
};

const skillCards: Array<{
  key: string;
  icon: string;
  title: LocalizedText;
  description: LocalizedText;
  active: boolean;
}> = [
  {
    key: "speak",
    icon: "🗣️",
    title: { da: "Tale", en: "Speaking", id: "Berbicara" },
    description: {
      da: "Du bruger sproget aktivt i dialoger og mundtlige svar.",
      en: "You use the language actively in dialogues and spoken answers.",
      id: "Anda menggunakan bahasa secara aktif dalam dialog dan jawaban lisan."
    },
    active: skillSignals.speak
  },
  {
    key: "listen",
    icon: "🎧",
    title: { da: "Lytning", en: "Listening", id: "Menyimak" },
    description: {
      da: "Du afkoder indhold gennem dialog, lyd eller lærerinput.",
      en: "You decode meaning through dialogue, audio, or teacher input.",
      id: "Anda memahami makna melalui dialog, audio, atau input pengajar."
    },
    active: skillSignals.listen
  },
  {
    key: "read",
    icon: "📖",
    title: { da: "Læsning", en: "Reading", id: "Membaca" },
    description: {
      da: "Du læser ord, mønstre og modeltekster som del af lektionen.",
      en: "You read words, patterns, and model texts as part of the lesson.",
      id: "Anda membaca kosakata, pola, dan teks model sebagai bagian dari pelajaran."
    },
    active: skillSignals.read
  },
  {
    key: "write",
    icon: "✍️",
    title: { da: "Skrivning", en: "Writing", id: "Menulis" },
    description: {
      da: "Du producerer egne sætninger, beskeder eller korte tekster.",
      en: "You produce your own sentences, messages, or short texts.",
      id: "Anda membuat kalimat, pesan, atau teks pendek sendiri."
    },
    active: skillSignals.write
  }
];

function getActivityIcon(kind: "listen" | "speak" | "build" | "reflect") {
  if (kind === "speak") return "🗣️";
  if (kind === "listen") return "🎧";
  if (kind === "build") return "✍️";
  return "💭";
}

function getActivityLabel(kind: "listen" | "speak" | "build" | "reflect"): LocalizedText {
  if (kind === "speak") {
    return { da: "Tale", en: "Speaking", id: "Berbicara" };
  }

  if (kind === "listen") {
    return { da: "Lytning", en: "Listening", id: "Menyimak" };
  }

  if (kind === "build") {
    return { da: "Skrivning & form", en: "Writing & form", id: "Menulis & bentuk" };
  }

  return { da: "Refleksion", en: "Reflection", id: "Refleksi" };
}
---

<BaseLayout
  title={`${t(lesson.data.title, locale)} | BahasaBroen`}
  description={t(lesson.data.summary, locale)}
  locale={locale}
  pair={pair}
>
  <div class="premium-bg">
    <div class="glow-sphere sphere-1"></div>
    <div class="glow-sphere sphere-2"></div>
    <div class="glow-sphere sphere-3"></div>
  </div>

  <div class="lesson-container">
    <header class="lesson-hero animated">
      <div class="hero-inner">
        <nav class="breadcrumb" aria-label={t(uiCopy.breadcrumb, locale)}>
          <a href={`/${locale}/${pair}/`} class="bc-link">{getDirectionLabel(pair, locale)}</a>
          <span class="sep" aria-hidden="true">/</span>
          <a href={`/${locale}/${pair}/${course}/`} class="bc-link">
            {courseData ? t(courseData.data.title, locale) : course}
          </a>
          <span class="sep" aria-hidden="true">/</span>
          <span class="active">{t(lesson.data.unit.title, locale)}</span>
        </nav>
        <h1 class="text-gradient-deep">{t(lesson.data.title, locale)}</h1>
        <p class="hero-lead">{t(lesson.data.summary, locale)}</p>
        <div class="meta-row">
          <span class="duration-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            {lesson.data.durationMinutes} {uiText.minutes[locale]}
          </span>
        </div>
        <div class="objective-chips">
          {lesson.data.objectives.map((obj) => (
            <span class="glass-chip">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              {t(obj, locale)}
            </span>
          ))}
        </div>
      </div>
    </header>

    <main class="lesson-grid-layout">
      <section class="lesson-section animated delay-1">
        <div class="section-meta">
          <span class="tag">{uiText.interaction[locale]}</span>
          <h2>{uiText.learningModules[locale]}</h2>
        </div>
        <div class="premium-glass-card">
          <ModeSplit locale={locale} teacher={lesson.data.modes.teacher} selfStudy={lesson.data.modes.selfStudy} />
        </div>
      </section>

      <section class="lesson-section animated delay-1">
        <div class="section-meta">
          <span class="tag">{uiText.skills[locale]}</span>
          <h2>{uiText.thisTrains[locale]}</h2>
        </div>
        <div class="skill-stage">
          <div class="skill-stage-copy">
            <p>
              {uiText.skillIntro[locale]}
            </p>
          </div>
          <div class="skill-grid">
          {skillCards.map((skill) => (
            <article class={`skill-card ${skill.active ? "is-active" : "is-supporting"}`}>
              <div class="skill-head">
                <span class="skill-icon" aria-hidden="true">{skill.icon}</span>
                <div>
                  <h3>{t(skill.title, locale)}</h3>
                  <span class="skill-state">{skill.active ? uiText.activeHere[locale] : uiText.supporting[locale]}</span>
                </div>
              </div>
              <p>{t(skill.description, locale)}</p>
            </article>
          ))}
          </div>
        </div>
      </section>

      <section class="lesson-section animated delay-2">
        <div class="section-meta">
          <span class="tag">{uiText.context[locale]}</span>
          <h2>{uiText.modelDialogue[locale]}</h2>
        </div>
        <div class="dialogue-river">
          {lesson.data.dialogue.map((turn, i) => (
            <div class={`chat-bubble-v2 ${i % 2 === 0 ? 'left' : 'right'}`}>
              <div class="bubble-meta">{turn.speaker}</div>
              <div class="bubble-content">
                <strong class="target-text" lang={pairMeta[pair].target}>{turn.target}</strong>
                <p class="source-text" lang={pairMeta[pair].source}>{turn.source}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <div class="knowledge-split animated delay-3">
        <section class="split-column">
          <div class="section-meta">
            <span class="tag">{uiText.lexicon[locale]}</span>
            <h2>{uiText.wordBank[locale]}</h2>
          </div>
          <div class="premium-list-card">
            {lesson.data.vocabulary.map((v) => (
              <div class="vocab-entry">
                <div class="word-group">
                  <span class="target" lang={pairMeta[pair].target}>{v.target}</span>
                  <span class="source" lang={pairMeta[pair].source}>{v.source}</span>
                </div>
                {v.note && <span class="note-pill">{t(v.note, locale)}</span>}
              </div>
            ))}
          </div>
        </section>

        <section class="split-column">
          <div class="section-meta">
            <span class="tag">{uiText.structure[locale]}</span>
            <h2>{uiText.grammar[locale]}</h2>
          </div>
          <div class="grammar-container">
            {lesson.data.grammar.map((g) => (
              <div class="grammar-feature-card">
                <h3>{g.pattern}</h3>
                <p>{t(g.explanation, locale)}</p>
                <div class="example-box">
                  {g.examples.map((ex) => (
                    <div class="ex-item">
                      <span class="ex-target" lang={pairMeta[pair].target}>{ex.target}</span>
                      <span class="ex-source" lang={pairMeta[pair].source}>{ex.source}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>

      <section class="lesson-section animated delay-4">
        <div class="section-meta centered">
          <span class="tag">{uiText.practice[locale]}</span>
          <h2>{uiText.exercises[locale]}</h2>
        </div>
        <div class="activity-mosaic">
          {lesson.data.activities.map((act) => (
            <div class="activity-vault-card">
              <div class="vault-icon">{getActivityIcon(act.kind)}</div>
              <div class="vault-body">
                <h3>{t(act.prompt, locale)}</h3>
                <span class="activity-kind">{t(getActivityLabel(act.kind), locale)}</span>
                <span class="type-indicator">{t(act.answerShape, locale)}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>

    <nav class="lesson-nav animated delay-5" aria-label={t(uiCopy.ariaLessonNav, locale)}>
      <div class="nav-side">
        {prevLesson ? (
          <a
            href={`/${locale}/${pair}/${prevLesson.data.courseSlug}/${prevLesson.data.unit.slug}/${prevLesson.data.slug}/`}
            class="nav-link prev"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            <div class="nav-info">
              <span class="nav-label">{uiText.previousLesson[locale]}</span>
              <span class="nav-title">{t(prevLesson.data.title, locale)}</span>
            </div>
          </a>
        ) : (
          <a href={`/${locale}/${pair}/${course}/`} class="nav-link prev">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            <div class="nav-info">
              <span class="nav-label">{uiText.backTo[locale]}</span>
              <span class="nav-title">{courseData ? t(courseData.data.title, locale) : "Kurset"}</span>
            </div>
          </a>
        )}
      </div>

      <a href={`/${locale}/${pair}/${course}/`} class="nav-course-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        {uiText.courseOverview[locale]}
      </a>

      <div class="nav-side nav-right">
        {nextLesson && (
          <a
            href={`/${locale}/${pair}/${nextLesson.data.courseSlug}/${nextLesson.data.unit.slug}/${nextLesson.data.slug}/`}
            class="nav-link next"
          >
            <div class="nav-info">
              <span class="nav-label">{uiText.nextLesson[locale]}</span>
              <span class="nav-title">{t(nextLesson.data.title, locale)}</span>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        )}
      </div>
    </nav>
  </div>

  <style>
    :root {
      --glass: rgba(255, 255, 255, 0.7);
      --glass-border: rgba(255, 255, 255, 0.4);
      --premium-shadow: 0 20px 50px rgba(13, 26, 28, 0.08);
    }

    .lesson-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 2rem 10rem;
      position: relative;
      z-index: 10;
    }

    .lesson-hero {
      padding: 6rem 0 5rem;
      text-align: center;
    }
    .hero-inner { max-width: 850px; margin: 0 auto; }

    /* Breadcrumb */
    .breadcrumb {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.05em;
      color: var(--muted);
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .bc-link {
      color: var(--muted);
      text-decoration: none;
      transition: color 0.2s;
      border-bottom: 1px solid transparent;
    }
    .bc-link:hover {
      color: var(--teal);
      border-bottom-color: var(--teal);
    }
    .breadcrumb .sep { color: var(--accent); opacity: 0.4; }
    .breadcrumb .active { color: var(--teal); font-weight: 800; }

    .meta-row {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .duration-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--muted);
      background: var(--bg-deep);
      padding: 0.4rem 1rem;
      border-radius: 999px;
    }

    .text-gradient-deep {
      font-size: clamp(3rem, 6vw, 5rem);
      background: linear-gradient(135deg, var(--teal) 20%, var(--accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1.1;
      margin-bottom: 2rem;
    }

    .hero-lead {
      font-size: 1.4rem;
      color: var(--muted);
      line-height: 1.6;
      font-weight: 500;
      margin-bottom: 2.5rem;
    }

    .objective-chips {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }
    .glass-chip {
      background: var(--glass);
      backdrop-filter: blur(10px);
      border: 1px solid var(--glass-border);
      padding: 0.7rem 1.5rem;
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--teal);
      box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }

    /* Section Meta */
    .section-meta { margin-bottom: 3rem; }
    .section-meta.centered { text-align: center; }
    .section-meta .tag {
      color: var(--accent);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 0.75rem;
      display: block;
      margin-bottom: 0.8rem;
    }
    .section-meta h2 { font-size: 2.8rem; margin: 0; }

    .lesson-section { margin-bottom: 8rem; }

    .skill-stage {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at top left, rgba(255, 138, 61, 0.16), transparent 30%),
        radial-gradient(circle at bottom right, rgba(28, 77, 79, 0.12), transparent 35%),
        rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(28, 77, 79, 0.08);
      border-radius: 36px;
      padding: 2rem;
      box-shadow: var(--premium-shadow);
      backdrop-filter: blur(10px);
    }
    .skill-stage::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(120deg, rgba(255, 255, 255, 0.26), transparent 45%),
        linear-gradient(300deg, rgba(255, 255, 255, 0.22), transparent 40%);
      pointer-events: none;
    }
    .skill-stage-copy {
      position: relative;
      z-index: 1;
      margin-bottom: 1.5rem;
      max-width: 58ch;
    }
    .skill-stage-copy p {
      margin: 0;
      font-size: 1.05rem;
      color: var(--muted);
    }
    .skill-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .skill-card {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(13, 26, 28, 0.06);
      border-radius: 28px;
      padding: 1.5rem;
      box-shadow: 0 12px 24px rgba(13, 26, 28, 0.05);
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .skill-card.is-active {
      border-color: rgba(28, 77, 79, 0.18);
      background: linear-gradient(180deg, rgba(28, 77, 79, 0.1), rgba(255, 255, 255, 0.96));
      box-shadow: 0 18px 30px rgba(28, 77, 79, 0.09);
    }
    .skill-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 30px rgba(13, 26, 28, 0.08);
    }
    .skill-head {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.9rem;
    }
    .skill-icon {
      width: 3rem;
      height: 3rem;
      display: grid;
      place-items: center;
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(255, 138, 61, 0.18), rgba(28, 77, 79, 0.12));
      font-size: 1.35rem;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }
    .skill-card h3 {
      font-size: 1.15rem;
      margin: 0 0 0.2rem;
    }
    .skill-state {
      display: inline-block;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 900;
      color: var(--accent);
    }
    .skill-card p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.55;
    }

    /* Dialogue River */
